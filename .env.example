# --- Nugen ---
NUGEN_API_KEY=
NUGEN_BASE_URL=https://api.nugen.in
NUGEN_BASE_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
# USD per 1M tokens for the spend guard, calibrated from platform billing ($0.6-0.8 per model per eval run)
NUGEN_PRICE_PER_MTOK_USD=38
NUGEN_SPEND_HARD_LIMIT_USD=40
# Alignment cost is not reported by the API; this conservative estimate is charged per run
NUGEN_ALIGNMENT_COST_EST_USD=20

# --- App ---
DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0
# Comma-separated client API keys accepted by the API (X-API-Key header)
CLIENT_API_KEYS=dev-key-change-me
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_SECONDS=3600
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- public demo (Render/Vercel); see docs/DEPLOY.md ---
DEMO_MODE=false
DEMO_ACCESS_CODE=
DEMO_DAILY_CAP_USD=1
DEMO_TOTAL_CAP_USD=5
DEMO_IP_MESSAGES_PER_HOUR=10
# Only for `make demo-seed` (copies the LOCAL database into Neon). Never set on Render.
DEMO_DATABASE_URL=
