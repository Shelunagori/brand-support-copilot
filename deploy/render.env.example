# Render -> brand-support-copilot-api -> Environment. Values marked [secret] are typed into the
# dashboard only (render.yaml declares them with sync: false). Never commit real values.
DEMO_MODE=true
NUGEN_API_KEY=                      # [secret] from platform.nugen.in
DATABASE_URL=                       # [secret] Neon: postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
REDIS_URL=                          # [secret] Upstash: rediss://default:PASSWORD@xxx.upstash.io:6379
DEMO_ACCESS_CODE=                   # [secret] e.g. 3 random words; share it privately
CORS_ORIGINS=                       # https://YOUR-APP.vercel.app
NUGEN_BASE_MODEL_ID=meta-llama/Llama-3.2-3B-Instruct
DEMO_DAILY_CAP_USD=1
DEMO_TOTAL_CAP_USD=5
DEMO_IP_MESSAGES_PER_HOUR=10
NUGEN_PRICE_PER_MTOK_USD=38
LOG_LEVEL=INFO
