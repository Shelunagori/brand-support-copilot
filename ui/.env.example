# ---------------------------------------------------------------------------
# Vercel (public demo) — set ONLY this, in Project Settings → Environment Variables:
#   VITE_API_BASE=https://<your-render-service>.onrender.com
# Do NOT set VITE_API_KEY on Vercel: the demo backend's read endpoints are public and
# chat is unlocked per visitor with an access code. The build fails if a key is set
# (see vite.config.ts) unless ALLOW_API_KEY_IN_BUNDLE=1.
# ---------------------------------------------------------------------------

# API base URL. Default /api: the Vite dev server (and nginx in Docker) proxies /api -> backend.
VITE_API_BASE=/api

# Optional. Sent as X-API-Key only when non-empty. Local dev gets dev-key-change-me from
# .env.development; leave empty for any public build.
VITE_API_KEY=
